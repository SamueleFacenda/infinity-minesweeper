{
  "name": "infinite-minesweeper",
  "version": "0.1.0",
  "description": "Infinite minesweeper webapp with no-guess boards, built with nix",
  "license": "EUPL-1.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/index.html src/style.css src/favicon.svg dist/",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "serve": "python3 -m http.server 8080 --directory dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
